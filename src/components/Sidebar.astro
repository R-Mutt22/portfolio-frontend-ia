</aside>

<style>
  .sidebar {
    width: 68px;
    height: 100vh;
    background-color: #131314;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 0;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
    border-right: 1px solid #1e1f20;
  }

  .top-nav, .social-links {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    align-items: center;
  }

  a {
    color: #c4c7c5;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
  }

  a:hover {
    color: #ffffff;
    background-color: #1e1f20;
  }

  a.active {
    color: #ffffff;
    background-color: #004a77;
  }

  .user-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    background-color: #1e1f20;
    border: 1px solid #2d2f31;
    image-rendering: pixelated;
  }

  /* --- RESPONSIVE PARA MOVILES --- */
  @media (max-width: 768px) {
    .sidebar {
      width: 100%;
      height: 56px;
      flex-direction: row;
      top: auto;
      bottom: 0;
      border-right: none;
      border-top: 1px solid #282a2c;
      padding: 0 1rem;
    }

    .top-nav, .social-links {
      flex-direction: row;
      gap: 0.5rem;
    }

    /* Ocultar algunas redes sociales en móviles muy pequeños para no saturar */
    .social-links a:nth-child(n+4) {
      display: none;
    }

    a {
      width: 34px;
      height: 34px;
    }

    .user-avatar {
      width: 30px;
      height: 30px;
    }
  }
</style>